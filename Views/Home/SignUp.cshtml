


@{
    ViewData["Title"] = "Login Page";
}
<style>
    .hero-section {
        background: linear-gradient(180deg, rgba(42,82,152,0.05), rgba(30,60,114,0.03));
        padding: 4rem 1rem;
        font-family: 'Poppins', sans-serif;
    }
    .auth-card {
        max-width: 450px;
        width: 100%;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 14px;
        padding: 2rem;
        box-shadow: 0 6px 18px rgba(30,60,114,0.08);
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .auth-card:hover { transform: translateY(-4px); }
    .card-title { color: #1e3c72; font-weight:700; text-align:center; margin-bottom:1rem; }
    .input-group-text { background: transparent; border-right: 0; color: #1e3c72; }
    .form-control { border-left: 0; }
    .btn-hero-primary {
        background: #ff8c42;
        color: #fff;
        border-radius: 30px;
        font-weight: 600;
        border: none;
        padding: .6rem 1.25rem;
        box-shadow: 0 6px 18px rgba(255,140,66,0.12);
        transition: transform .12s ease, box-shadow .12s ease;
    }
    .btn-hero-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(255,140,66,0.18); }
    .small-muted { color:#6c757d; font-size:.9rem }
    @@media (max-width: 576px) {
        .auth-card { width: 90%; padding: 1.25rem; }
    }
</style>

<section class="hero-section">
    <div class="auth-card">
        <h2 class="card-title">Create your account</h2>
        <form id="studenteForm" novalidate class="needs-validation">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label for="firstname" class="form-label small-muted"><i class="bi bi-person me-2"></i>First name</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" id="firstname" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="lastname" class="form-label small-muted"><i class="bi bi-person me-2"></i>Last name</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input type="text" class="form-control" id="lastname" required />
                </div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label small-muted"><i class="bi bi-envelope me-2"></i>Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input type="email" class="form-control" id="email" />
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label small-muted"><i class="bi bi-lock me-2"></i>Password</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                    <input type="password" class="form-control" id="password" />
                </div>
            </div>

            <div class="d-grid">
                <button type="button" id="submituser" class="btn btn-hero-primary" onclick="addUser()">Create account</button>
            </div>
        </form>
    </div>
</section>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<script type="text/javascript">
    function addUser() {
        let user = {
            FirstName: $("#firstname").val(),
            LastName: $("#lastname").val(),
            Email: $("#email").val(),
            Password: $("#password").val(),
            Role: "user",
            Active: 1
        };
        let promise1 = axios.post("/Home/Register", user);
        promise1.then((response) => {
            const result = response.data;
            if(result!=null) { window.location.href="/Home/Login"; }
        });
    }
</script>
