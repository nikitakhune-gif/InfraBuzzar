                </p>
                <div class="ib-mv-cols">
                    <div class="ib-mv-item">
                        <div class="icon-circle"><i class="bi bi-people"></i></div>
                        <div>
                            <h6>Mission</h6>
                            <p>To provide a reliable marketplace that simplifies procurement and drives business success.</p>
                        </div>
                    </div>
                    <div class="ib-mv-item">
                        <div class="icon-circle"><i class="bi bi-eye"></i></div>
                        <div>
                            <h6>Vision</h6>
                            <p>To become a leading platform for infrastructure equipment trade through technology and trust.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CORE VALUES + INDUSTRIES -->
    <section class="section ib-cv-section">
        <div class="container-narrow ib-cv-grid">
            <div>
                <h4>Our Core Values</h4>
                <div class="eyebrow-line"></div>
                <div class="ib-cv-items">
                    <div class="ib-cv-item">
                        <div class="icon-circle"><i class="bi bi-gem"></i></div>
                        <span>Excellence</span>
                    </div>
                    <div class="ib-cv-item">
                        <div class="icon-circle"><i class="bi bi-shield-lock"></i></div>
                        <span>Integrity</span>
                    </div>
                    <div class="ib-cv-item">
                        <div class="icon-circle"><i class="bi bi-people"></i></div>
                        <span>Collaboration</span>
                    </div>
                    <div class="ib-cv-item">
                        <div class="icon-circle"><i class="bi bi-lightbulb"></i></div>
                        <span>Innovation</span>
                    </div>
                    <div class="ib-cv-item">
                        <div class="icon-circle"><i class="bi bi-award"></i></div>
                        <span>Accountability</span>
                    </div>
                </div>
            </div>
            <div>
                <h4>Categories We Serve</h4>
                <div class="eyebrow-line"></div>
                <div class="ib-ind-grid">
                    <div class="ib-ind-item">
                        <i class="bi bi-cone-striped"></i>
                        <span>Roads &amp; Highways</span>
                    </div>
                    <div class="ib-ind-item">
                        <i class="bi bi-building"></i>
                        <span>Buildings &amp; Construction</span>
