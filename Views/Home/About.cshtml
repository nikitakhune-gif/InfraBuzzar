                    <div class="ib-ind-item">
                        <i class="bi bi-droplet"></i>
                        <span>Water Supply Equipment</span>
                    </div>
                    <div class="ib-ind-item">
                        <i class="bi bi-lightning-charge"></i>
                        <span>Power &amp; Energy</span>
                    </div>
                    <div class="ib-ind-item">
                        <i class="bi bi-buildings"></i>
                        <span>Smart Cities</span>
                    </div>
                    <div class="ib-ind-item">
                        <i class="bi bi-gear"></i>
                        <span>Industrial Equipment</span>
                    </div>
                    <div class="ib-ind-item">
                        <i class="bi bi-bank"></i>
                        <span>Government Projects</span>
                    </div>
                    <div class="ib-ind-item">
                        <i class="bi bi-graph-up-arrow"></i>
                        <span>Urban Development</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="ib-footer">
        <div class="ib-footer-grid">
            <div>
                <div class="brand">
                    <i class="bi bi-building"></i>
                    <div>
                        <h6>InfraBuzzar</h6>
                        <small>BUY &nbsp;|&nbsp; SELL &nbsp;|&nbsp; DELIVER</small>
                    </div>
                </div>
                <p>Empowering infrastructure procurement with a smart marketplace, real-time insights and secure vendor collaboration.</p>
                <div class="socials">
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-twitter-x"></i></a>
                    <a href="#"><i class="bi bi-linkedin"></i></a>
                    <a href="#"><i class="bi bi-youtube"></i></a>
                </div>
