@{
    ViewData["Title"] = "Home";
}

<style>
    /* ---------- Hero ---------- */
    .home-hero {
        position: relative;
        border-radius: 14px;
        overflow: hidden;
        min-height: 420px;
        display: flex;
        align-items: center;
        margin-top: 1.5rem;
        margin-bottom: 3.5rem;
        background: linear-gradient(120deg, #1e3c72 0%, #2a5298 55%, #ff8c42 150%);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18);
        padding: 3rem 2.5rem;
    }

        .home-hero::before,
        .home-hero::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            opacity: 0.14;
            background: #fff;
        }

        .home-hero::before {
            width: 300px;
            height: 300px;
            top: -100px;
            right: 5%;
        }

        .home-hero::after {
            width: 200px;
            height: 200px;
            bottom: -70px;
            left: 4%;
        }

    .home-hero-content {
        position: relative;
        z-index: 2;
        max-width: 640px;
        color: #fff;
    }

        .home-hero-content .badge-pill {
            display: inline-block;
            background: rgba(255, 255, 255, 0.16);
            padding: 0.4rem 1rem;
            border-radius: 30px;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            letter-spacing: 0.5px;
        }

        .home-hero-content h1 {
            font-weight: 700;
            font-size: 2.7rem;
            line-height: 1.25;
            margin-bottom: 1rem;
        }

            .home-hero-content h1 span {
                color: #ffd7a8;
            }

        .home-hero-content p {
            font-size: 1.05rem;
            line-height: 1.75;
            color: rgba(255, 255, 255, 0.92);
            margin-bottom: 1.8rem;
        }

        .home-hero-content .btn-hero-primary {
            background: #ff8c42;
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 0.7rem 1.8rem;
            border-radius: 30px;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .home-hero-content .btn-hero-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(255, 140, 66, 0.45);
                color: #fff;
            }

        .home-hero-content .btn-hero-outline {
            border: 1.5px solid rgba(255, 255, 255, 0.7);
            color: #fff;
            font-weight: 600;
            padding: 0.7rem 1.8rem;
            border-radius: 30px;
            margin-left: 0.8rem;
            transition: all 0.2s ease;
        }

            .home-hero-content .btn-hero-outline:hover {
                background: rgba(255, 255, 255, 0.15);
                color: #fff;
            }

    /* ---------- Section heading ---------- */
    .section-heading {
        text-align: center;
        margin-bottom: 2.2rem;
    }

        .section-heading h2 {
            font-weight: 700;
            color: #1e3c72;
        }

        .section-heading p {
            color: #6c7688;
            max-width: 560px;
            margin: 0.4rem auto 0;
        }

    /* ---------- Category cards ---------- */
    .categories {
        margin-bottom: 3.5rem;
    }

    .category-card {
        background: #fff;
        border-radius: 12px;
        text-align: center;
        padding: 1.8rem 1rem;
        height: 100%;
        box-shadow: 0 6px 18px rgba(30, 60, 114, 0.07);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 26px rgba(30, 60, 114, 0.15);
        }

        .category-card .icon-wrap {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: rgba(255, 140, 66, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .category-card i {
            font-size: 1.6rem;
            color: #ff8c42;
        }

        .category-card h6 {
            font-weight: 600;
            color: #1e3c72;
            margin: 0;
        }

    /* ---------- Feature strip ---------- */
    .features {
        background: #fff;
        border-radius: 14px;
        padding: 2.5rem 2rem;
        margin-bottom: 3.5rem;
        box-shadow: 0 6px 18px rgba(30, 60, 114, 0.06);
    }

    .feature-item {
        text-align: center;
        padding: 0.6rem;
    }

        .feature-item i {
            font-size: 2rem;
            color: #1e3c72;
            margin-bottom: 0.8rem;
        }

        .feature-item h6 {
            font-weight: 600;
            margin-bottom: 0.4rem;
        }

        .feature-item p {
            color: #6c7688;
            font-size: 0.92rem;
            margin: 0;
        }

    /* ---------- CTA banner ---------- */
    .cta-banner {
        background: linear-gradient(90deg, #1e3c72, #2a5298);
        border-radius: 14px;
        padding: 2.5rem 2rem;
        text-align: center;
        color: #fff;
        margin-bottom: 2rem;
    }

        .cta-banner h3 {
            font-weight: 700;
            margin-bottom: 0.6rem;
        }

        .cta-banner p {
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 1.4rem;
        }

        .cta-banner .btn {
            background: #ff8c42;
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 0.65rem 1.8rem;
            border-radius: 30px;
            transition: transform 0.2s ease;
        }

            .cta-banner .btn:hover {
                transform: translateY(-2px);
                color: #fff;
            }

    @@media (max-width: 767px) {
        .home-hero-content h1 {
            font-size: 2rem;
        }

        .home-hero {
            padding: 2rem 1.4rem;
            min-height: auto;
        }

        .home-hero-content .btn-hero-outline {
            margin-left: 0;
            margin-top: 0.6rem;
            display: inline-block;
        }
    }
</style>

<!-- ================= Hero Section ================= -->
<section class="home-hero">
    <div class="home-hero-content">
        <span class="badge-pill">India's Trusted Infra Marketplace</span>
        <h1>Building material, <span>sorted the smart way.</span></h1>
        <p>
            80+ verified products from 50+ trusted sellers across North India &mdash; quality checked at our
            in-house testing lab, delivered straight to your site. No more haggling street to street.
        </p>
        <a asp-controller="Home" asp-action="SignUp" class="btn btn-hero-primary">Get Started</a>
        <a asp-controller="Home" asp-action="About" class="btn btn-hero-outline">Learn More</a>
    </div>
</section>

<!-- ================= Categories ================= -->
<section class="categories">
    <div class="section-heading">
        <h2>Shop by Category</h2>
        <p>Everything you need for your project, all in one place.</p>
    </div>
    <div class="row g-4">
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card">
                <div class="icon-wrap"><i class="bi bi-bricks"></i></div>
                <h6>Cement &amp; Bricks</h6>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card">
                <div class="icon-wrap"><i class="bi bi-nut"></i></div>
                <h6>Steel &amp; Hardware</h6>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card">
                <div class="icon-wrap"><i class="bi bi-lightning-charge"></i></div>
                <h6>Electricals</h6>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card">
                <div class="icon-wrap"><i class="bi bi-droplet"></i></div>
                <h6>Plumbing &amp; Sanitary</h6>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card">
                <div class="icon-wrap"><i class="bi bi-grid-3x3-gap"></i></div>
                <h6>Tiles &amp; Flooring</h6>
            </div>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <div class="category-card">
                <div class="icon-wrap"><i class="bi bi-tree"></i></div>
                <h6>Wood &amp; Plywood</h6>
            </div>
        </div>
    </div>
</section>

<!-- ================= Features ================= -->
<section class="features">
    <div class="row g-4">
        <div class="col-md-3 col-6">
            <div class="feature-item">
                <i class="bi bi-patch-check"></i>
                <h6>Quality Assured</h6>
                <p>Checked at our in-house lab</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="feature-item">
                <i class="bi bi-truck"></i>
                <h6>Fast Delivery</h6>
                <p>Straight to your site</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="feature-item">
                <i class="bi bi-shop"></i>
                <h6>50+ Sellers</h6>
                <p>Verified across North India</p>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="feature-item">
                <i class="bi bi-cash-coin"></i>
                <h6>Fair Pricing</h6>
                <p>Transparent, no haggling</p>
            </div>
        </div>
    </div>
</section>

<!-- ================= CTA Banner ================= -->
<section class="cta-banner">
    <h3>Ready to build smarter?</h3>
    <p>Join InfraBuzzar today and get access to verified sellers and quality-checked materials.</p>
    <a asp-controller="Home" asp-action="SignUp" class="btn">Create Free Account</a>
</section>
