@{
    ViewData["Title"] = "Order Confirmed";
}

<style>
    .confirm-wrapper {
        max-width: 600px;
        margin: 80px auto;
        text-align: center;
        padding: 50px 30px;
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,0.1);
    }

    .confirm-icon {
        font-size: 60px;
        color: #28a745;
        margin-bottom: 15px;
    }

    .confirm-wrapper h2 {
        color: #1a3d6d;
        font-weight: 700;
        margin-bottom: 12px;
    }

    .confirm-wrapper p {
        color: #666;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .confirm-btn {
        display: inline-block;
        background: #f7941d;
        color: #fff;
        padding: 12px 32px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.15s;
    }

        .confirm-btn:hover {
            background: #e08312;
            color: #fff;
        }
</style>

<div class="confirm-wrapper">
    <div class="confirm-icon">&#10003;</div>
    <h2>Order Placed Successfully!</h2>
    <p>Thank you for shopping with InfraBuzzar. Your order is being processed and will be delivered soon.</p>
    <a href="/Product/ViewAll" class="confirm-btn">Continue Shopping</a>
</div>
