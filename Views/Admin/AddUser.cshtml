@model InfraBuzzar.Models.User

@{
    ViewData["Title"] = "AddUser";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>

<style>
    :root {
    --ib-primary: #1e3c72;
    --ib-primary-dark: #142a52;
    --ib-accent: #ff8c42;
    --ib-light-bg: #f6f8fb;
    }

    .adduser-wrapper {
    display: flex;
    justify-content: center;
    padding: 2.5rem 1rem 3.5rem;
    }

    .adduser-card {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 10px 32px rgba(20, 42, 82, 0.12);
    overflow: hidden;
    }

    .adduser-head {
    background: linear-gradient(90deg, var(--ib-primary) 0%, #2a5298 100%);
    padding: 2rem 2rem 1.6rem;
    text-align: center;
    }

    .adduser-head .badge-tag {
    display: inline-block;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-weight: 600;
    font-size: 0.8rem;
    padding: 0.3rem 0.9rem;
    border-radius: 20px;
    margin-bottom: 0.7rem;
    }

    .adduser-head h2 {
    color: #fff;
    font-weight: 700;
    font-size: 1.6rem;
    margin: 0;
    }

    .adduser-head h2 span {
    color: var(--ib-accent);
    }

    .adduser-head p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    margin: 0.4rem 0 0;
    }

    .adduser-body {
    padding: 2rem 2.2rem 2.2rem;
    }

    .adduser-body .form-group {
    margin-bottom: 1.15rem;
    }

    .adduser-body label {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--ib-primary-dark);
    margin-bottom: 0.35rem;
    display: block;
    }

    .adduser-body .form-control {
    border: 1px solid #e1e5ee;
    border-radius: 10px;
    padding: 0.6rem 0.9rem;
    font-size: 0.92rem;
    background-color: var(--ib-light-bg);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .adduser-body .form-control:focus {
    border-color: var(--ib-primary);
    box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
    background-color: #fff;
    outline: none;
    }

    #addbtn {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
    }

    #addbtn .btn-primary {
    flex: 1;
    background-color: var(--ib-accent);
    border: none;
    color: #fff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.7rem 1rem;
    border-radius: 24px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    #addbtn .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 140, 66, 0.4);
    color: #fff;
    }

    #addbtn a {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ib-primary);
    text-decoration: none;
    white-space: nowrap;
    }

    #addbtn a:hover {
    color: var(--ib-accent);
    text-decoration: underline;
    }
</style>

<div class="adduser-wrapper">
    <div class="adduser-card">
        <div class="adduser-head">
            <span class="badge-tag">Admin Console</span>
            <h2>Create New <span>User</span></h2>
            <p>Add a user account and assign a role</p>
        </div>

        <div class="adduser-body">
            <form id="adduser" novalidate class="needs-validation">

                <div class="form-group">
                    <label for="firstname">First Name</label>
                    <input type="text" class="form-control" id="firstname" placeholder="Enter first name" />
                </div>

                <div class="form-group">
                    <label for="lastname">Last Name</label>
                    <input type="text" class="form-control" id="lastname" placeholder="Enter last name" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" class="form-control" id="email" placeholder="name@example.com" />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" class="form-control" id="password" placeholder="Enter password" />
                </div>

                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" class="form-control">
                        <option value="admin">Admin</option>
                        <option value="manager">Manager</option>
                        <option value="user">User</option>
                    </select>
                </div>

                <div class="form-group" id="addbtn">
                    <button type="button" class="btn btn-primary" onclick="addUser()">Add User</button>
                    <a href="/Admin/ShowAllUser">View All &rarr;</a>
                </div>

            </form>
        </div>
    </div>
</div>

<script type="text/javascript">
    function addUser() {

    let user = {
    FirstName: $("#firstname").val(),
    LastName: $("#lastname").val(),
    Email: $("#email").val(),
    Password: $("#password").val(),
    Role: $("#role").val(),
    Active: 1
    };

    axios.post("/Admin/AddUser", user)
    .then(response => {
    if (response.data === true) {
    window.location.href = "/Admin/ShowAllUser";
    }
    });
    }
</script>
