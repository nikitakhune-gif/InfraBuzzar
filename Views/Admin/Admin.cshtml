@*
    Admin.cshtml - InfraBuzzar
    Stylish admin dashboard matching the site's layout theme
    (gradient navbar colors, Poppins font, card-based UI).
*@
@{
}
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Admin";
}

@*@{
    User LoginUser = HttpContext.Session.GetString("LoginUser");
}*@

<style>
    :root {
        --ib-primary: #1e3c72;
        --ib-primary-dark: #142a52;
        --ib-accent: #ff8c42;
        --ib-light-bg: #f6f8fb;
    }

    .admin-wrapper {
        padding: 2.5rem 1rem 3rem;
    }

    .admin-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

        .admin-header .badge-tag {
            display: inline-block;
            background: rgba(30, 60, 114, 0.08);
            color: var(--ib-primary);
            font-weight: 600;
            font-size: 0.85rem;
            padding: 0.35rem 1rem;
            border-radius: 20px;
            margin-bottom: 0.75rem;
        }

        .admin-header h1 {
            font-weight: 700;
            color: var(--ib-primary-dark);
            font-size: 2.1rem;
        }

            .admin-header h1 span {
                color: var(--ib-accent);
            }

        .admin-header p {
            color: #6b7280;
            max-width: 520px;
            margin: 0.5rem auto 0;
        }

    .admin-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.5rem;
        max-width: 1100px;
        margin: 0 auto;
    }

    .admin-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        text-align: center;
        text-decoration: none;
        box-shadow: 0 4px 18px rgba(20, 42, 82, 0.08);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.9rem;
        border: 1px solid rgba(30, 60, 114, 0.06);
    }

        .admin-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(20, 42, 82, 0.16);
        }

        .admin-card .icon-circle {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--ib-primary) 0%, #2a5298 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            color: #fff;
            transition: background 0.25s ease;
        }

        .admin-card:nth-child(2) .icon-circle,
        .admin-card:nth-child(5) .icon-circle {
            background: linear-gradient(135deg, var(--ib-accent) 0%, #ff6a00 100%);
        }

        .admin-card h5 {
            font-weight: 600;
            color: var(--ib-primary-dark);
            margin: 0;
            font-size: 1.05rem;
        }

        .admin-card p {
            color: #8a94a6;
            font-size: 0.85rem;
            margin: 0;
        }

        .admin-card .go-link {
            color: var(--ib-accent);
            font-weight: 600;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .admin-card:hover .icon-circle {
            background: linear-gradient(135deg, var(--ib-accent) 0%, #ff6a00 100%);
        }
</style>

<div class="admin-wrapper">
    <div class="admin-header">
        <span class="badge-tag">Admin Console</span>
        <h1>Manage Infra<span>Buzzar</span></h1>
        <p>Add products, manage categories and users, all from one clean dashboard.</p>
    </div>

    <div class="admin-grid">
        <a class="admin-card" href="/Product/AddProduct">
            <div class="icon-circle"><i class="bi bi-plus-circle"></i></div>
            <h5>Add New Product</h5>
            <p>List a new product for sale</p>
            <span class="go-link">Open <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="admin-card" href="/Product/ViewAll">
            <div class="icon-circle">
                <i class="bi bi-grid-3x3-gap"></i>
            </div>
            <h5>View All Products</h5>
            <p>Browse and purchase products from the marketplace</p>
            <span class="go-link">
                Open <i class="bi bi-arrow-right"></i>
            </span>
        </a>

        <a class="admin-card" href="/Admin/ViewAllAdmin">
            <div class="icon-circle"><i class="bi bi-box-seam"></i></div>
            <h5>Product Management</h5>
            <p>View, edit or remove products</p>
            <span class="go-link">Open <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="admin-card" href="/Category/ShowAllCategory">
            <div class="icon-circle"><i class="bi bi-tags"></i></div>
            <h5>Category Management</h5>
            <p>Organize product categories</p>
            <span class="go-link">Open <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="admin-card" href="/User/AddUser">
            <div class="icon-circle"><i class="bi bi-person-plus"></i></div>
            <h5>Create User</h5>
            <p>Add a new user account</p>
            <span class="go-link">Open <i class="bi bi-arrow-right"></i></span>
        </a>

        <a class="admin-card" href="/Home/ShowAllUser">
            <div class="icon-circle"><i class="bi bi-people"></i></div>
            <h5>User Management</h5>
            <p>View and manage all users</p>
            <span class="go-link">Open <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>
</div>
