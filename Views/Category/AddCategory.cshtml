@model Category
@{
    ViewData["Title"] = "AddCategory";
}

<style>
    :root {
        --ib-primary: #1e3c72;
        --ib-primary-dark: #142a52;
        --ib-accent: #ff8c42;
        --ib-light-bg: #f6f8fb;
    }

    .addcategory-wrapper {
        display: flex;
        justify-content: center;
        padding: 2.5rem 1rem 3.5rem;
    }

    .addcategory-card {
        width: 100%;
        max-width: 480px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 32px rgba(20, 42, 82, 0.12);
        overflow: hidden;
    }

    .addcategory-head {
        background: linear-gradient(90deg, var(--ib-primary) 0%, #2a5298 100%);
        padding: 2rem 2rem 1.6rem;
        text-align: center;
    }

        .addcategory-head .badge-tag {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.3rem 0.9rem;
            border-radius: 20px;
            margin-bottom: 0.7rem;
        }

        .addcategory-head h2 {
            color: #fff;
            font-weight: 700;
            font-size: 1.6rem;
            margin: 0;
        }

            .addcategory-head h2 span {
                color: var(--ib-accent);
            }

        .addcategory-head p {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.9rem;
            margin: 0.4rem 0 0;
        }

    .addcategory-body {
        padding: 2rem 2.2rem 2.2rem;
    }

        .addcategory-body .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--ib-primary-dark);
            margin-bottom: 0.35rem;
            display: block;
        }

        .addcategory-body .form-control {
            border: 1px solid #e1e5ee;
            border-radius: 10px;
            padding: 0.6rem 0.9rem;
            font-size: 0.92rem;
            background-color: var(--ib-light-bg);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .addcategory-body .form-control:focus {
                border-color: var(--ib-primary);
                box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
                background-color: #fff;
                outline: none;
            }

        .addcategory-body .text-danger {
            font-size: 0.8rem;
        }

        .addcategory-body .btn-primary {
            width: 100%;
            background-color: var(--ib-accent);
            border: none;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            padding: 0.7rem 1rem;
            border-radius: 24px;
            margin-top: 0.5rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

            .addcategory-body .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(255, 140, 66, 0.4);
                color: #fff;
            }
</style>

<div class="addcategory-wrapper">
    <div class="addcategory-card">
        <div class="addcategory-head">
            <span class="badge-tag">Admin Console</span>
            <h2>Add New <span>Category</span></h2>
            <p>Create a category to organize your products</p>
        </div>

        <div class="addcategory-body">
            <form method="post" asp-action="AddCategory" asp-controller="Category">

                <div class="form-outline mb-4">
                    <label asp-for="CategoryName" class="form-label"></label>
                    <input asp-for="CategoryName" class="form-control" placeholder="Enter category name" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-block mb-4">
                    Add Category
                </button>

            </form>
        </div>
    </div>
</div>
