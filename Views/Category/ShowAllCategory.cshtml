@model List<InfraBuzzar.Models.Category>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    :root {
        --ib-navy: #1a3d6d;
        --ib-navy-dark: #12294a;
        --ib-orange: #f7941d;
        --ib-orange-dark: #e08312;
    }

    .ib-cat-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px 60px 20px;
    }

    .ib-cat-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 26px;
        flex-wrap: wrap;
        gap: 14px;
    }

        .ib-cat-header h2 {
            color: var(--ib-navy);
            font-weight: 800;
            margin: 0;
            font-size: 26px;
        }

            .ib-cat-header h2 span {
                color: var(--ib-orange);
            }

        .ib-cat-header p {
            color: #777;
            font-size: 14px;
            margin: 4px 0 0 0;
        }

    .ib-add-cat-btn {
        background: var(--ib-orange);
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        padding: 11px 22px;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: background 0.15s;
    }

        .ib-add-cat-btn:hover {
            background: var(--ib-orange-dark);
            color: #fff;
        }

    .ib-cat-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 3px 14px rgba(0,0,0,0.07);
        overflow: hidden;
    }

    .ib-cat-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14.5px;
    }

        .ib-cat-table thead th {
            background: var(--ib-navy);
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            padding: 15px 18px;
            text-align: left;
        }

        .ib-cat-table tbody td {
            padding: 14px 18px;
            border-bottom: 1px solid #f0f0f0;
            color: #333;
            vertical-align: middle;
        }

        .ib-cat-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ib-cat-table tbody tr:hover {
            background: #f7f9fc;
        }

    .ib-cat-id {
        color: #999;
        font-weight: 600;
    }

    .ib-cat-name {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        color: #1f2937;
    }

        .ib-cat-name i {
            color: var(--ib-navy);
            background: #eaf1fb;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
        }

    .ib-cat-delete {
        color: #d9534f;
        font-weight: 700;
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .ib-cat-delete:hover {
            text-decoration: underline;
        }

    .ib-cat-empty {
        text-align: center;
        padding: 50px 20px;
        color: #d9534f;
    }

        .ib-cat-empty i {
            font-size: 38px;
            color: #f3c9c7;
            margin-bottom: 12px;
            display: block;
        }
</style>

<div class="ib-cat-page">
    <div class="ib-cat-header">
        <div>
            <h2>Product <span>Categories</span></h2>
            <p>Manage the categories used across the InfraBuzzar catalog</p>
        </div>
        <a href="/Category/AddCategory" class="ib-add-cat-btn">
            <i class="bi bi-plus-lg"></i> Add New Category
        </a>
    </div>

    <div class="ib-cat-card">
        @if (Model != null && Model.Count > 0)
        {
            <table class="ib-cat-table">
                <thead>
                    <tr>
                        <th>Category ID</th>
                        <th>Category Name</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ib-cat-id">#@cat.CategoryId</td>
                            <td>
                                <div class="ib-cat-name">
                                    <i class="bi bi-tag"></i> @cat.CategoryName
                                </div>
                            </td>
                            <td>
                                <a href="/Category/DeleteCategory/@cat.CategoryId" class="ib-cat-delete" onclick="return confirm('Delete this category?');">
                                    <i class="bi bi-trash3"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="ib-cat-empty">
                <i class="bi bi-tags"></i>
                No categories found.
            </div>
        }
    </div>
</div>
