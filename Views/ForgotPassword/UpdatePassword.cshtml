@{
    ViewData["Title"] = "UpdatePassword";
}

<style>
    :root {
        --ib-primary: #1e3c72;
        --ib-primary-dark: #142a52;
        --ib-accent: #ff8c42;
        --ib-light-bg: #f6f8fb;
    }

    .updatepass-wrapper {
        display: flex;
        justify-content: center;
        padding: 2.5rem 1rem 3.5rem;
    }

    .updatepass-card {
        width: 100%;
        max-width: 480px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 32px rgba(20, 42, 82, 0.12);
        overflow: hidden;
    }

    .updatepass-head {
        background: linear-gradient(90deg, var(--ib-primary) 0%, #2a5298 100%);
        padding: 2rem 2rem 1.6rem;
        text-align: center;
    }

        .updatepass-head .badge-tag {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.3rem 0.9rem;
            border-radius: 20px;
            margin-bottom: 0.7rem;
        }

        .updatepass-head h2 {
            color: #fff;
            font-weight: 700;
            font-size: 1.6rem;
            margin: 0;
        }

            .updatepass-head h2 span {
                color: var(--ib-accent);
            }

        .updatepass-head p {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.9rem;
            margin: 0.4rem 0 0;
        }

    .updatepass-body {
        padding: 2rem 2.2rem 2.2rem;
    }

        .updatepass-body .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--ib-primary-dark);
            margin-bottom: 0.35rem;
            display: block;
        }

        .updatepass-body .form-control {
            border: 1px solid #e1e5ee;
            border-radius: 10px;
            padding: 0.6rem 0.9rem;
            font-size: 0.92rem;
            background-color: var(--ib-light-bg);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            width: 100%;
            box-sizing: border-box;
        }

            .updatepass-body .form-control:focus {
                border-color: var(--ib-primary);
                box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
                background-color: #fff;
                outline: none;
            }

            .updatepass-body .form-control[readonly] {
                color: #6b7688;
                cursor: not-allowed;
            }

        .updatepass-body .text-danger {
            font-size: 0.8rem;
        }

        .updatepass-body .btn-primary {
            width: 100%;
            background-color: var(--ib-accent);
            border: none;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            padding: 0.7rem 1rem;
            border-radius: 24px;
            margin-top: 0.5rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }

            .updatepass-body .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(255, 140, 66, 0.4);
                color: #fff;
            }
</style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js"></script>

@{
    User user = ViewData["user"] as User;
}

<div class="updatepass-wrapper">
    <div class="updatepass-card">
        <div class="updatepass-head">
            <span class="badge-tag">Account Recovery</span>
            <h2>Update <span>Password</span></h2>
            <p>Set a new password for your account</p>
        </div>

        <div class="updatepass-body">
            <form id="updatePassForm">

                <div class="form-outline mb-4">
                    <label class="form-label" for="name">User Name</label>
                    <input type="text" id="name" class="form-control" value="@user?.FirstName" readonly />
                </div>

                <div class="form-outline mb-4">
                    <label class="form-label" for="email">User Email</label>
                    <input type="text" id="email" class="form-control" value="@user?.Email" readonly />
                </div>

                <div class="form-outline mb-4">
                    <label class="form-label" for="newpass">New Password</label>
                    <input type="password" id="newpass" class="form-control" placeholder="Enter new password" />
                </div>

                <button type="button" class="btn btn-primary btn-block mb-4" onclick="updatepass()">
                    Change Password
                </button>

            </form>
        </div>
    </div>
</div>

<script type="text/javascript">

    function updatepass() {

    let user = {
    FirstName: $("#name").val(),
    Email: $("#email").val(),
    Password: $("#newpass").val()
    };

    console.log(user);

    let promise1 = axios.post("/ForgotPassword/ChangePassword", user);
    promise1.then((response) => {
    var result = response.data;
    console.log(result);

    if (result.success) {
    alert("Password updated successfully");
    window.location.href = "/Home/Login";
    } else {
    alert(result.message || "Something went wrong");
    }
    });
    promise1.catch((error) => {
    alert("Something Went Wrong");
    });
    }
</script>
