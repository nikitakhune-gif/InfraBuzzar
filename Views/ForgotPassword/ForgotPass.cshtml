@{
    ViewData["Title"] = "ForgotPassword";
}

<style>
    :root {
        --ib-primary: #1e3c72;
        --ib-primary-dark: #142a52;
        --ib-accent: #ff8c42;
        --ib-light-bg: #f6f8fb;
    }

    .forgotpass-wrapper {
        display: flex;
        justify-content: center;
        padding: 2.5rem 1rem 3.5rem;
    }

    .forgotpass-card {
        width: 100%;
        max-width: 480px;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 10px 32px rgba(20, 42, 82, 0.12);
        overflow: hidden;
    }

    .forgotpass-head {
        background: linear-gradient(90deg, var(--ib-primary) 0%, #2a5298 100%);
        padding: 2rem 2rem 1.6rem;
        text-align: center;
    }

        .forgotpass-head .badge-tag {
            display: inline-block;
            background: rgba(255, 255, 255, 0.15);
            color: #fff;
            font-weight: 600;
            font-size: 0.8rem;
            padding: 0.3rem 0.9rem;
            border-radius: 20px;
            margin-bottom: 0.7rem;
        }

        .forgotpass-head h2 {
            color: #fff;
            font-weight: 700;
            font-size: 1.6rem;
            margin: 0;
        }

            .forgotpass-head h2 span {
                color: var(--ib-accent);
            }

        .forgotpass-head p {
            color: rgba(255, 255, 255, 0.85);
            font-size: 0.9rem;
            margin: 0.4rem 0 0;
        }

    .forgotpass-body {
        padding: 2rem 2.2rem 2.2rem;
    }

        .forgotpass-body .form-label {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--ib-primary-dark);
            margin-bottom: 0.35rem;
            display: block;
        }

        .forgotpass-body .form-control {
            border: 1px solid #e1e5ee;
            border-radius: 10px;
            padding: 0.6rem 0.9rem;
            font-size: 0.92rem;
            background-color: var(--ib-light-bg);
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            width: 100%;
            box-sizing: border-box;
        }

            .forgotpass-body .form-control:focus {
                border-color: var(--ib-primary);
                box-shadow: 0 0 0 3px rgba(30, 60, 114, 0.12);
                background-color: #fff;
                outline: none;
            }

        .forgotpass-body .text-danger {
            font-size: 0.8rem;
        }

        .forgotpass-body .btn-primary {
            width: 100%;
            background-color: var(--ib-accent);
            border: none;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            padding: 0.7rem 1rem;
            border-radius: 24px;
            margin-top: 0.5rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }

            .forgotpass-body .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 16px rgba(255, 140, 66, 0.4);
                color: #fff;
            }
</style>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/1.7.2/axios.min.js"></script>

<div class="forgotpass-wrapper">
    <div class="forgotpass-card">
        <div class="forgotpass-head">
            <span class="badge-tag">Account Recovery</span>
            <h2>Forgot <span>Password</span></h2>
            <p>Enter your email to receive a one-time password</p>
        </div>

        <div class="forgotpass-body">
            <form id="forgotForm">

                <div class="form-outline mb-4">
                    <label class="form-label" for="email">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email" />
                </div>

                <button type="button" class="btn btn-primary btn-block mb-4" onclick="GetUser()">
                    Get OTP
                </button>

            </form>
        </div>
    </div>
</div>

<script type="text/javascript">

    function GetUser() {

    console.log("GetUser function call");
    let email = $("#email").val();
    let email2 = JSON.stringify(email);
    console.log(email);
    console.log(email2);

    let promise1 = axios.post("/ForgotPassword/ForgotPass", email2, {
    headers: { "Content-Type": "application/json" }
    });
    promise1.then((response) => {
    var result = response.data;
    console.log(result);
    if (result.success) {

    console.log("OTP SEND SUCCESFULLY ON YOUR MAIL");

    window.location.href = "/ForgotPassword/VerifyOtp";
    } else {
    alert(result.message || "Something went wrong");
    }
    });
    promise1.catch((error) => {
    alert("Something Went Wrong");
    });
    }
</script>
