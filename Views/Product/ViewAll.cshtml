@using Newtonsoft.Json;

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://unpkg.com/axios/dist/axios.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/ViewAll.css" asp-append-version="true" />

<style>
    :root {
    --ib-navy: #1a3d6d;
    --ib-navy-dark: #12294a;
    --ib-orange: #f7941d;
    --ib-orange-dark: #e08312;
    }

    .ib-products-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 40px 20px 60px 20px;
    }

    .ib-products-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
    flex-wrap: wrap;
    gap: 14px;
    }

    .ib-products-header h2 {
    color: var(--ib-navy);
    font-weight: 800;
    margin: 0;
    font-size: 26px;
    }

    .ib-products-header h2 span {
    color: var(--ib-orange);
    }

    .ib-products-header p {
    color: #777;
    font-size: 14px;
    margin: 4px 0 0 0;
    }

    .ib-cart-btn {
    background: var(--ib-navy);
    color: #fff;
    border: none;
    padding: 11px 22px;
    border-radius: 30px;
    font-weight: 700;
    font-size: 14.5px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.15s;
    }

    .ib-cart-btn:hover {
    background: var(--ib-navy-dark);
    color: #fff;
    }

    .ib-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
    }

    .ib-product-card {
    background: #fff;
    border-radius: 14px;
    box-shadow: 0 3px 14px rgba(0,0,0,0.07);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s, box-shadow 0.18s;
    }

    .ib-product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 24px rgba(26,61,109,0.15);
    }

    .ib-product-image-wrap {
    background: #f4f7fb;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    }

    .ib-product-image-wrap img {
    max-height: 100%;
    max-width: 100%;
    object-fit: contain;
    }

    .ib-product-id-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(26,61,109,0.9);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    }

    .ib-product-body {
    padding: 18px 18px 20px 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
    }

    .ib-product-body h5 {
    color: #1f2937;
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 8px;
    }

    .ib-product-body p {
    color: #777;
    font-size: 13.5px;
    line-height: 1.6;
    margin-bottom: 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    }

    .ib-product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid #f0f0f0;
    padding-top: 14px;
    }

    .ib-product-price {
    color: var(--ib-navy);
    font-weight: 800;
    font-size: 18px;
    }

    .ib-product-price small {
    color: #999;
    font-weight: 500;
    font-size: 12px;
    }

    .ib-add-btn {
    background: var(--ib-orange);
    color: #fff;
    border: none;
    padding: 9px 18px;
    border-radius: 24px;
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: background 0.15s;
    }

    .ib-add-btn:hover {
    background: var(--ib-orange-dark);
    color: #fff;
    }

    .ib-empty-state {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    }

    .ib-empty-state i {
    font-size: 42px;
    color: #cfd8e6;
    margin-bottom: 14px;
    }
</style>

@{
    List<Product> Prodlist = ViewData["products"] as List<Product>;
}

<div class="ib-products-page">
    <div class="ib-products-header">
        <div>
            <h2>Our <span>Products</span></h2>
            <p>Verified building materials from trusted vendors across North India</p>
        </div>
        <button class="ib-cart-btn" type="button" onclick="showcart()">
            <i class="bi bi-cart3"></i> Show Cart
        </button>
    </div>

    @if (Prodlist != null && Prodlist.Count > 0)
    {
        <div class="ib-product-grid">
            @foreach (Product prod in Prodlist)
            {
                <div class="ib-product-card">
                    <div class="ib-product-image-wrap">
                        <span class="ib-product-id-badge">#@prod.ProductId</span>
                        <img src="~/Images/@prod.ProductImage" alt="@prod.ProductName" onerror="this.src='/images/no-image.png'" />
                    </div>
                    <div class="ib-product-body">
                        <h5>@prod.ProductName</h5>
                        <p>@prod.ProductDescription</p>
                        <div class="ib-product-footer">
                            <div class="ib-product-price">
                                ₹ @prod.ProductPrice<br />
                                <small>per unit</small>
                            </div>
                            <button class="ib-add-btn" type="button" onclick="addCart(@prod.ProductId)">
                                <i class="bi bi-cart-plus"></i> Add
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="ib-empty-state">
            <i class="bi bi-box-seam"></i>
            <p>No products found right now.</p>
        </div>
    }
</div>

<script type="text/javascript">
    function addCart(Id) {
    // Send single product id to server immediately
    axios.post('/Cart/AddToCart', [Id])
    .then(function (response) {
    // success - redirect to cart or show toast
    console.log('Added to cart', response.data);
    // Optionally navigate to cart page
    // window.location.href = '/Cart/ShowCart';
    alert('Product added to cart');
    })
    .catch(function (error) {
    console.error(error);
    if (error.response && error.response.status === 401) {
    alert('Please Login First');
    window.location.href = '/Home/Login';
    } else {
    alert('Failed to add product to cart');
    }
    });
    };

    function showcart() {
    // Simply navigate to the cart page (server will use session user)
    window.location.href = '/Cart/ShowCart';
    }
</script>
